        <mxCell id="collab48" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;spacingTop=2;spacingBottom=2;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;3.1&lt;/b&gt; ↓ monitor_overdues() and demand_recommendations()&lt;br&gt;&lt;b&gt;3.8&lt;/b&gt; ↑ &lt;i&gt;Overdue summary and demand recommendations&lt;/i&gt;" vertex="1">
          <mxGeometry height="36" width="340" x="1385" y="800" as="geometry" />
        </mxCell>
        <mxCell id="collab49" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;spacingTop=2;spacingBottom=2;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;3.2&lt;/b&gt; → Check due dates of active issues&lt;br&gt;&lt;b&gt;3.3&lt;/b&gt; ← &lt;i&gt;Overdue records&lt;/i&gt;&lt;br&gt;&lt;b&gt;3.4&lt;/b&gt; → Calculate and store fines (deterministic ₹ per day)&lt;br&gt;&lt;b&gt;3.5&lt;/b&gt; → Queue OVERDUE notifications (PENDING)&lt;br&gt;&lt;b&gt;3.7.1&lt;/b&gt; → Read demand data (SEARCH_DEMAND_LOGS, BOOKS)&lt;br&gt;&lt;b&gt;3.7.2&lt;/b&gt; ← &lt;i&gt;Demand counts and inventory levels&lt;/i&gt;" vertex="1">
          <mxGeometry height="88" width="380" x="1560" y="1057" as="geometry" />
        </mxCell>
        <mxCell id="collab50" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;spacingTop=2;spacingBottom=2;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;3.6&lt;/b&gt; → Send overdue notification (for each overdue record)&lt;br&gt;&lt;b&gt;3.7&lt;/b&gt; ← &lt;i&gt;Update notification status (SENT / FAILED)&lt;/i&gt;" vertex="1">
          <mxGeometry height="49" width="300" x="935" y="988" as="geometry" />
        </mxCell>
        <mxCell id="collab51" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" value="1.0 Search and Intelligent Assistance" vertex="1">
          <mxGeometry height="34" width="380" x="40" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="collab52" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="2.0 Records and Resource Management (Issue)" vertex="1">
          <mxGeometry height="34" width="380" x="440" y="1230" as="geometry" />
