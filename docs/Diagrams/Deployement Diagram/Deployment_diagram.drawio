        <mxCell id="collab54" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="4.0 Return Process" vertex="1">
          <mxGeometry height="34" width="380" x="40" y="1274" as="geometry" />
